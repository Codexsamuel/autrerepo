      "url": "/novacore/novaworld/services?category=domestic",
      "icons": [
        {
          "src": "/icons/home-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Artisans & Techniciens",
      "short_name": "Artisans",
      "description": "Trouvez un artisan ou technicien",
      "url": "/novacore/novaworld/services?category=artisans",
      "icons": [
        {
          "src": "/icons/wrench-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Urgence 24/7",
      "short_name": "Urgence",
      "description": "Service d'urgence disponible jour et nuit",
      "url": "/novacore/novaworld/services?emergency=true",
      "icons": [
        {
          "src": "/icons/alert-96x96.png",
          "sizes": "96x96"
        }
      ]

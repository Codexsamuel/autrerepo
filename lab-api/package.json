    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "axios": "^1.6.0",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",

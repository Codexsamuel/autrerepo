# Configuration d'accès rapide pour le développement
# ⚠️  NE PAS COMMITER EN PRODUCTION

# Activation du système d'accès rapide
QUICK_ACCESS_ENABLED=true
QUICK_ACCESS_MIDDLEWARE_ENABLED=true

# Code secret personnel (votre code)
QUICK_ACCESS_SECRET_CODE=0987612345SamuelObamSuperAdmin1234509876

# Configuration des tokens
QUICK_ACCESS_TOKEN_EXPIRY_DAYS=30
QUICK_ACCESS_SALT=quick-access-salt-2024

# Configuration biométrique pour le développement
BIOMETRIC_SECRET_KEY=dev-secret-key-2024
ENCRYPTION_KEY=dev-encryption-key-2024

# Désactivation des vérifications strictes en développement
VALIDATE_FINGERPRINT_QUALITY=false
REQUIRE_MULTIPLE_CAPTURES=false
ENCRYPT_FINGERPRINTS=false

# Logs de développement
BIOMETRIC_LOG_LEVEL=DEBUG
BIOMETRIC_LOG_FILE=logs/dev_quick_access.log

# Stockage de développement
BIOMETRIC_STORAGE_PATH=data/dev_quick_access
CAPTURE_STORAGE_PATH=data/dev_quick_access/captures

# Performance de développement
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
MAX_CONCURRENT_PROCESSES=2

# Mode développement
GDPR_COMPLIANT=false
ENCRYPT_PII=false
AUDIT_TRAIL=false

# Bypass superadmin (alternative)
SUPERADMIN_BYPASS_ENABLED=true
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD_HASH=dev-password-hash
SUPERADMIN_SALT=superadmin-salt-2024 
# =============================================================================
# NOVAIA - Configuration d'environnement
# =============================================================================
# Copiez ce fichier vers .env et ajustez les valeurs selon votre environnement

# =============================================================================
# ENVIRONNEMENT
# =============================================================================
NODE_ENV=development
ENVIRONMENT=local

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# OLLAMA (LLM/Embeddings locaux)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_ORIGINS=*
OLLAMA_MODELS_PATH=./models

# =============================================================================
# APIs
# =============================================================================
# API de contrôle (NestJS)
CONTROL_API_URL=http://localhost:4000
CONTROL_WS_PUBLIC=ws://localhost:4001

# API des agents (FastAPI)
AGENTS_API_URL=http://localhost:8000
AGENTS_API_HOST=0.0.0.0
AGENTS_API_PORT=8000

# =============================================================================
# APPLICATIONS FRONTEND
# =============================================================================
# Marketplace
MARKETPLACE_PORT=3000
MARKETPLACE_URL=http://localhost:3000

# NovaCore
NOVACORE_PORT=3001
NOVACORE_URL=http://localhost:3001

# Battle Arena
BATTLE_ARENA_PORT=3002
BATTLE_ARENA_URL=http://localhost:3002

# Agent Lab
AGENT_LAB_PORT=3003
AGENT_LAB_URL=http://localhost:3003

# =============================================================================
# SÉCURITÉ
# =============================================================================
JWT_SECRET=novaia-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Chiffrement
ENCRYPTION_KEY=your-32-character-encryption-key-here
ENCRYPTION_ALGORITHM=AES-256-GCM

# RBAC/ABAC
RBAC_ENABLED=true
ABAC_ENABLED=true
POLICY_PATH=./policies

# =============================================================================
# VECTOR STORE
# =============================================================================
VECTOR_DB_PATH=./data/faiss
VECTOR_DB_TYPE=faiss
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# =============================================================================
# RAG & LLM
# =============================================================================
DEFAULT_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.9

# =============================================================================
# PERFORMANCE & RESSOURCES
# =============================================================================
# GPU/CUDA
CUDA_ENABLED=true
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_LIMIT=12GB

# CPU/DirectML
CPU_THREADS=8
MAX_WORKERS=4

# Cache
CACHE_TTL=3600
VECTOR_CACHE_SIZE=1000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/novaia.log

# =============================================================================
# MONITORING
# =============================================================================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
PROMETHEUS_PORT=9090

# =============================================================================
# EXTERNAL SERVICES (optionnels)
# =============================================================================
# Stripe (facturation)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloud Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# =============================================================================
# AIRGAP MODE
# =============================================================================
AIRGAP_MODE=false
EXTERNAL_CALLS_ALLOWED=true
UPDATE_SOURCE=local

# =============================================================================
# DRONE BUILDER (version civile/sûre)
# =============================================================================
DRONE_SIMULATOR_ENABLED=true
DRONE_3D_EXPORT_ENABLED=true
DRONE_COMPLIANCE_CHECK=true

# =============================================================================
# BATTLE ARENA
# =============================================================================
ELO_K_FACTOR=32
ELO_INITIAL_RATING=1200
BATTLE_TIMEOUT=300
ANTI_CHEAT_ENABLED=true

# =============================================================================
# AGENT GENESIS
# =============================================================================
BLUEPRINT_COMPILER_ENABLED=true
SKILL_LIBRARY_PATH=./skills
AGENT_TEMPLATES_PATH=./templates 
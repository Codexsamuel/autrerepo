# Configuration Superadmin - Accès de développement
# ⚠️  NE PAS COMMITER CE FICHIER EN PRODUCTION
# Copiez ce fichier vers .env.superadmin et modifiez les valeurs

# Activation du bypass superadmin
SUPERADMIN_BYPASS_ENABLED=true

# Identifiants du superadmin principal (vous)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD_HASH=your-custom-password-hash-here

# Salt pour le hashage des mots de passe
SUPERADMIN_SALT=superadmin-salt-2024

# Durée d'expiration des tokens de bypass (en heures)
SUPERADMIN_BYPASS_EXPIRY_HOURS=24

# Superadmins additionnels (séparés par des virgules)
ADDITIONAL_SUPERADMINS=dev1,dev2,admin

# Configuration biométrique pour le développement
BIOMETRIC_SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# Désactivation de certaines vérifications en développement
VALIDATE_FINGERPRINT_QUALITY=false
REQUIRE_MULTIPLE_CAPTURES=false
ENCRYPT_FINGERPRINTS=false

# Logs de développement
BIOMETRIC_LOG_LEVEL=DEBUG
BIOMETRIC_LOG_FILE=logs/dev_biometric_auth.log

# Stockage de développement
BIOMETRIC_STORAGE_PATH=data/dev_fingerprints
CAPTURE_STORAGE_PATH=data/dev_fingerprints/captures

# Performance de développement
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
MAX_CONCURRENT_PROCESSES=2

# Mode développement
GDPR_COMPLIANT=false
ENCRYPT_PII=false
AUDIT_TRAIL=false 